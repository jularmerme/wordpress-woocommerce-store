INSERT INTO `wp_postmeta` VALUES (16165,2177,'_elementor_data','[{\"id\":\"78694a2\",\"elType\":\"container\",\"settings\":{\"content_width\":\"full\",\"min_height\":{\"unit\":\"px\",\"size\":670,\"sizes\":[]},\"flex_justify_content\":\"center\",\"flex_align_items\":\"flex-start\",\"background_background\":\"classic\",\"background_image\":{\"url\":\"http:\\/\\/ecommerce-store.local\\/wp-content\\/uploads\\/2024\\/07\\/Header-Image-LLandudno-1.jpg\",\"id\":2009,\"size\":\"2048x2048\",\"alt\":\"\",\"source\":\"library\"},\"background_position\":\"initial\",\"background_ypos\":{\"unit\":\"px\",\"size\":-79,\"sizes\":[]},\"background_attachment\":\"fixed\",\"background_repeat\":\"no-repeat\",\"background_size\":\"cover\",\"presetTitle\":\"Container\",\"presetIcon\":\"eicon-container\"},\"elements\":[{\"id\":\"b8b3a93\",\"elType\":\"container\",\"settings\":{\"content_width\":\"full\",\"flex_justify_content\":\"center\"},\"elements\":[{\"id\":\"76b0ca9\",\"elType\":\"widget\",\"settings\":{\"content_width\":\"full\",\"title\":\"Photography prints\",\"title_color\":\"#FFFFFF\",\"typography_typography\":\"custom\",\"typography_font_family\":\"Roboto\",\"typography_font_size\":{\"unit\":\"px\",\"size\":70,\"sizes\":[]},\"typography_font_weight\":\"600\"},\"elements\":[],\"widgetType\":\"heading\"},{\"id\":\"c8af80b\",\"elType\":\"widget\",\"settings\":{\"content_width\":\"full\",\"title\":\"By Andy Williams\",\"title_color\":\"#FFFFFF\",\"typography_typography\":\"custom\",\"typography_font_family\":\"Roboto\",\"typography_font_size\":{\"unit\":\"px\",\"size\":25,\"sizes\":[]},\"typography_font_weight\":\"normal\"},\"elements\":[],\"widgetType\":\"heading\"}],\"isInner\":true}],\"isInner\":false},{\"id\":\"00682cb\",\"elType\":\"container\",\"settings\":[],\"elements\":[{\"id\":\"9b19d29\",\"elType\":\"widget\",\"settings\":{\"content_width\":\"full\"},\"elements\":[],\"widgetType\":\"spacer\"}],\"isInner\":false},{\"id\":\"2073811\",\"elType\":\"container\",\"settings\":[],\"elements\":[{\"id\":\"fc0a08a\",\"elType\":\"widget\",\"settings\":{\"content_width\":\"full\",\"editor\":\"<p>Our fast and friendly service uses only the highest quality materials for your prints, producting accurate colour reproduction that will your breath away.<\\/p><p>Our photographs cover three genres:<\\/p><ol><li>Macro shots taken of the natural world around us. Be amazed at the details revealed using a specialist macro lens.<\\/li><li>Rare dog breeds that are protected in the UK.<\\/li><li>Owls &amp; other birds found in a sanctuary in North Wales.<\\/li><\\/ol>\",\"typography_typography\":\"custom\",\"typography_font_family\":\"Roboto\",\"typography_font_size\":{\"unit\":\"px\",\"size\":20,\"sizes\":[]},\"typography_font_weight\":\"400\"},\"elements\":[],\"widgetType\":\"text-editor\"}],\"isInner\":false},{\"id\":\"60ed9de\",\"elType\":\"container\",\"settings\":[],\"elements\":[{\"id\":\"f270a77\",\"elType\":\"widget\",\"settings\":{\"content_width\":\"full\"},\"elements\":[],\"widgetType\":\"spacer\"}],\"isInner\":false},{\"id\":\"fd5dc07\",\"elType\":\"container\",\"settings\":{\"container_type\":\"grid\",\"grid_columns_grid\":{\"unit\":\"fr\",\"size\":\"3\"},\"grid_rows_grid\":{\"unit\":\"fr\",\"size\":\"1\"},\"grid_rows_grid_mobile\":{\"unit\":\"fr\",\"size\":\"1\"}},\"elements\":[{\"id\":\"f5d7f9c\",\"elType\":\"container\",\"settings\":{\"content_width\":\"full\"},\"elements\":[{\"id\":\"44475f6\",\"elType\":\"widget\",\"settings\":{\"content_width\":\"full\",\"image\":{\"url\":\"http:\\/\\/ecommerce-store.local\\/wp-content\\/uploads\\/2024\\/07\\/small-flower-600x385-1.jpg\",\"id\":1380,\"size\":\"\",\"alt\":\"\",\"source\":\"library\"}},\"elements\":[],\"widgetType\":\"image\"},{\"id\":\"8f6453a\",\"elType\":\"widget\",\"settings\":{\"content_width\":\"full\",\"title\":\"Macro Natural History\",\"typography_typography\":\"custom\",\"typography_font_family\":\"Roboto\",\"typography_font_size\":{\"unit\":\"px\",\"size\":34,\"sizes\":[]},\"typogr