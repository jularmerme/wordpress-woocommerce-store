INSERT INTO `wp_options` VALUES (4347,'_site_transient_community-events-d41d8cd98f00b204e9800998ecf8427e','a:4:{s:9:\"sandboxed\";b:0;s:5:\"error\";N;s:8:\"location\";a:1:{s:2:\"ip\";b:0;}s:6:\"events\";a:4:{i:0;a:10:{s:4:\"type\";s:6:\"meetup\";s:5:\"title\";s:30:\"Marlborough WordPress: October\";s:3:\"url\";s:68:\"https://www.meetup.com/marlborough-wordpress-meetup/events/303670088\";s:6:\"meetup\";s:28:\"Marlborough WordPress Meetup\";s:10:\"meetup_url\";s:52:\"https://www.meetup.com/marlborough-wordpress-meetup/\";s:4:\"date\";s:19:\"2024-10-15 18:30:00\";s:8:\"end_date\";s:19:\"2024-10-15 20:00:00\";s:20:\"start_unix_timestamp\";i:1729031400;s:18:\"end_unix_timestamp\";i:1729036800;s:8:\"location\";a:4:{s:8:\"location\";s:6:\"Online\";s:7:\"country\";s:2:\"US\";s:8:\"latitude\";d:42.350000000000001;s:9:\"longitude\";d:-71.549999999999997;}}i:1;a:10:{s:4:\"type\";s:6:\"meetup\";s:5:\"title\";s:23:\"Boston WordPress Meetup\";s:3:\"url\";s:63:\"https://www.meetup.com/boston-wordpress-meetup/events/301104381\";s:6:\"meetup\";s:16:\"Boston WordPress\";s:10:\"meetup_url\";s:47:\"https://www.meetup.com/boston-wordpress-meetup/\";s:4:\"date\";s:19:\"2024-10-28 18:30:00\";s:8:\"end_date\";s:19:\"2024-10-28 21:30:00\";s:20:\"start_unix_timestamp\";i:1730154600;s:18:\"end_unix_timestamp\";i:1730165400;s:8:\"location\";a:4:{s:8:\"location\";s:18:\"Cambridge, MA, USA\";s:7:\"country\";s:2:\"us\";s:8:\"latitude\";d:42.361426999999999;s:9:\"longitude\";d:-71.081207000000006;}}i:2;a:10:{s:4:\"type\";s:6:\"meetup\";s:5:\"title\";s:31:\"Marlborough WordPress: November\";s:3:\"url\";s:68:\"https://www.meetup.com/marlborough-wordpress-meetup/events/303670109\";s:6:\"meetup\";s:28:\"Marlborough WordPress Meetup\";s:10:\"meetup_url\";s:52:\"https://www.meetup.com/marlborough-wordpress-meetup/\";s:4:\"date\";s:19:\"2024-11-19 18:30:00\";s:8:\"end_date\";s:19:\"2024-11-19 20:30:00\";s:20:\"start_unix_timestamp\";i:1732059000;s:18:\"end_unix_timestamp\";i:1732066200;s:8:\"location\";a