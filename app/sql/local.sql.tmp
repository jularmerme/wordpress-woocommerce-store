96 221 308 233L563 492 304 771C292 783 288 800 288 817 288 833 296 850 308 863 321 871 338 875 354 875 371 875 388 867 400 854L696 533Z\"></path></svg>					\n		<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo.</p>		\n			<a href=\"#\">\n									Visit Shop\n					</a>','Homepage','','inherit','closed','closed','','13-revision-v1','','','2024-07-30 19:43:11','2024-07-30 19:43:11','',13,'http://ecommerce-store.local/?p=2133',0,'revision','',0);
