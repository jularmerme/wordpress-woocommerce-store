INSERT INTO `wp_posts` VALUES (2048,1,'2024-07-30 16:55:07','2024-07-30 16:55:07','<style>/*! elementor - v3.23.0 - 25-07-2024 */\n.elementor-heading-title{padding:0;margin:0;line-height:1}.elementor-widget-heading .elementor-heading-title[class*=elementor-size-]>a{color:inherit;font-size:inherit;line-height:inherit}.elementor-widget-heading .elementor-heading-title.elementor-size-small{font-size:15px}.elementor-widget-heading .elementor-heading-title.elementor-size-medium{font-size:19px}.elementor-widget-heading .elementor-heading-title.elementor-size-large{font-size:29px}.elementor-widget-heading .elementor-heading-title.elementor-size-xl{font-size:39px}.elementor-widget-heading .elementor-heading-title.elementor-size-xxl{font-size:59px}</style><h2>Photography prints</h2>		\n			<h2>By Andy Williams</h2>		\n			<h2>Photography Prints</h2>		\n		<p>Our fast and friendly service uses only the highest quality materials for your prints, producting accurate colour reproduction that will your breath away.</p><p>Our photographs cover three genres:</p><ol><li>Macro shots taken of the natural world around us. Be amazed at the details revealed using a specialist macro lens.</li><li>Rare dog breeds that are protected in the UK.</li><li>Owls &amp; other birds found in a sanctuary in North Wales.</li></ol>','Homepage','','inherit','closed','closed','','13-revision-v1','','','2024-07-30 16:55:07','2024-07-30 16:55:07','',13,'http://ecommerce-store.local/?p=2048',0,'revision','',0);
